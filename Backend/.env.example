# Copy to .env and fill in. Never commit the real .env.

PORT=8080
HOST=0.0.0.0
NODE_ENV=development

# REQUIRED in production — the server refuses to boot without it.
# Generate a UNIQUE value per installation (do not reuse across deployments):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Postgres connection used by Prisma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mbdatabase"

SERVER_URL=http://localhost:8080

# Comma-separated list of browser origins allowed to call this API.
# Leave EMPTY for a same-origin / on-prem install: cross-origin requests are then
# denied outright. Only set this if the frontend is served from a different origin.
# e.g. CORS_ALLOWED_ORIGINS=http://192.168.200.20:3000
CORS_ALLOWED_ORIGINS=
